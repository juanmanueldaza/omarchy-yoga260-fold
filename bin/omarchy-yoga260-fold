#!/usr/bin/env python3
"""Tablet mode and auto-rotation for the Lenovo ThinkPad Yoga 260 on Omarchy.

The Yoga 260 is a 360 degree convertible, but it reports no tablet-mode switch:
there is no SW_TABLET_MODE bit on any of its input devices and no ACPI event for
the fold. Every other convertible plugin for Hyprland or Omarchy keys off that
switch, so on this machine they either refuse to work or degrade into rotating
on every tilt, including on a lap.

What the Yoga 260 does have is an Intel ISHTP hinge-angle sensor, exposed by
the kernel as an IIO device with three channels. Two of them are the tilt of
each half with respect to gravity, and the third is the fold angle between
them. That is strictly more information than a binary switch: it also tells the
difference between a tent and a flat-folded tablet, so the fold can be watched
directly instead of being guessed at from gravity alone.

The second half of the problem is that this machine's accelerometer lives in the
base, not the lid. A reader that takes the base's attitude as the screen's
attitude is only right while the machine is open, and exactly wrong once it is
folded -- which is the only time rotation matters. So the screen's attitude is
reconstructed by rotating the base's gravity vector through the measured fold
angle. See `lid_vector` for the derivation.

Everything is derived from sysfs and `hyprctl`; there is no third-party Python
dependency, no root, and no system service. The daemon refuses to rotate
anything unless it has positively identified the machine and read a coherent
set of sensor values, because a wrong rotation is worse than no rotation.
"""

from __future__ import annotations

import argparse
import json
import math
import os
import re
import shlex
import shutil
import signal
import subprocess
import sys
import time
from collections.abc import Iterable, Sequence
from dataclasses import dataclass, field
from itertools import pairwise
from pathlib import Path
from typing import Any

PLUGIN_ID = "juanmanueldaza.yoga260-fold"
PLUGIN_DIR = Path(__file__).resolve().parent.parent

STATE_HOME = Path(os.environ.get("XDG_STATE_HOME") or (Path.home() / ".local/state"))
STATE_FILE = STATE_HOME / "omarchy" / "yoga260-fold" / "state.json"
SHELL_JSON = Path.home() / ".config" / "omarchy" / "shell.json"
LIBWACOM_LOCAL = Path.home() / ".config" / "libwacom"
LIBWACOM_ENTRY = LIBWACOM_LOCAL / "wacom-isdv4-5091.tablet"
HWDB_LOCAL = Path("/etc/udev/hwdb.d/61-sensor-local.hwdb")

